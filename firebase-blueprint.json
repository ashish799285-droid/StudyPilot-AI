{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student profile, study habits, and streak metrics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth UID" },
        "name": { "type": "string", "description": "Student display name" },
        "email": { "type": "string", "description": "Student email address" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "gradeLevel": { "type": "string", "description": "Academic grade or university level" },
        "targetGoal": { "type": "string", "description": "Primary academic objective" },
        "streakDays": { "type": "number", "description": "Current daily consecutive study streak" },
        "lastStudyDate": { "type": "string", "description": "ISO date string of last active study day" },
        "totalStudyMinutes": { "type": "number", "description": "Cumulative minutes spent studying" },
        "completedTasksCount": { "type": "number", "description": "Total study tasks completed" }
      },
      "required": ["uid", "name", "email"]
    },
    "StudyPlan": {
      "title": "StudyPlan",
      "description": "Structured revision roadmap with milestones and daily study tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique study plan identifier" },
        "userId": { "type": "string", "description": "Owner student user ID" },
        "title": { "type": "string", "description": "Plan title" },
        "summary": { "type": "string", "description": "Overview description" },
        "examName": { "type": "string", "description": "Target exam or course name" },
        "examDate": { "type": "string", "description": "Target exam date or deadline" },
        "totalHoursPerWeek": { "type": "number", "description": "Weekly study budget in hours" },
        "weeklyMilestones": { "type": "array", "description": "Array of weekly study sprints and daily tasks" },
        "proTips": { "type": "array", "description": "Cognitive study recommendations" },
        "active": { "type": "boolean", "description": "Whether this is the primary active plan" },
        "createdAt": { "type": "number", "description": "Creation timestamp ms" }
      },
      "required": ["id", "userId", "title"]
    },
    "Note": {
      "title": "Note",
      "description": "Structured academic revision notes and cheat sheets",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique note identifier" },
        "userId": { "type": "string", "description": "Owner student user ID" },
        "topic": { "type": "string", "description": "Concept topic name" },
        "subject": { "type": "string", "description": "Academic subject" },
        "academicLevel": { "type": "string", "description": "Academic depth level" },
        "content": { "type": "string", "description": "Markdown formatted study content" },
        "tags": { "type": "array", "description": "Search and filter keywords" },
        "isFavorite": { "type": "boolean", "description": "Pinned/favorite indicator" },
        "createdAt": { "type": "number", "description": "Creation timestamp ms" },
        "updatedAt": { "type": "number", "description": "Last modified timestamp ms" }
      },
      "required": ["id", "userId", "topic", "content"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Active recall diagnostic quizzes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique quiz identifier" },
        "userId": { "type": "string", "description": "Owner student user ID" },
        "title": { "type": "string", "description": "Quiz title" },
        "subject": { "type": "string", "description": "Academic subject" },
        "topic": { "type": "string", "description": "Tested topic" },
        "difficulty": { "type": "string", "description": "Beginner / Intermediate / Advanced" },
        "questions": { "type": "array", "description": "Array of multiple choice questions" },
        "totalQuestions": { "type": "number", "description": "Question count" },
        "createdAt": { "type": "number", "description": "Creation timestamp ms" }
      },
      "required": ["id", "userId", "title", "questions"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Student quiz submission performance and answer telemetry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique result identifier" },
        "userId": { "type": "string", "description": "Student user ID" },
        "quizId": { "type": "string", "description": "Tested quiz ID" },
        "quizTitle": { "type": "string", "description": "Tested quiz title" },
        "subject": { "type": "string", "description": "Subject" },
        "topic": { "type": "string", "description": "Topic" },
        "difficulty": { "type": "string", "description": "Difficulty" },
        "score": { "type": "number", "description": "Points earned" },
        "totalQuestions": { "type": "number", "description": "Total question count" },
        "percentage": { "type": "number", "description": "Percentage score (0-100)" },
        "answers": { "type": "array", "description": "Selected answers list" },
        "timeSpentSeconds": { "type": "number", "description": "Elapsed time in seconds" },
        "completedAt": { "type": "number", "description": "Completion timestamp ms" }
      },
      "required": ["id", "userId", "quizId", "score", "totalQuestions"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Conversational AI study tutor dialogue and message history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique chat session identifier" },
        "userId": { "type": "string", "description": "Student user ID" },
        "title": { "type": "string", "description": "Session topic summary" },
        "subject": { "type": "string", "description": "Subject" },
        "academicLevel": { "type": "string", "description": "Academic level" },
        "messages": { "type": "array", "description": "Chronological chat turns" },
        "createdAt": { "type": "number", "description": "Creation timestamp ms" },
        "updatedAt": { "type": "number", "description": "Last activity timestamp ms" }
      },
      "required": ["id", "userId", "messages"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Recorded Pomodoro focus sessions and study duration logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique study session log ID" },
        "userId": { "type": "string", "description": "Student user ID" },
        "subject": { "type": "string", "description": "Studied subject" },
        "topic": { "type": "string", "description": "Specific studied topic" },
        "taskTitle": { "type": "string", "description": "Associated task title" },
        "planId": { "type": "string", "description": "Optional study plan ID" },
        "taskId": { "type": "string", "description": "Optional study plan task ID" },
        "plannedDurationMinutes": { "type": "number", "description": "Planned focus duration in minutes" },
        "actualDurationMinutes": { "type": "number", "description": "Actual focused time completed in minutes" },
        "status": { "type": "string", "description": "Completed | Partially completed | Interrupted | Cancelled" },
        "date": { "type": "string", "description": "Session date (YYYY-MM-DD)" },
        "startedAt": { "type": "number", "description": "Session start timestamp ms" },
        "completedAt": { "type": "number", "description": "Session end timestamp ms" },
        "notes": { "type": "string", "description": "Optional student session notes" }
      },
      "required": ["id", "userId", "subject", "topic", "actualDurationMinutes", "status"]
    },
    "RevisionCard": {
      "title": "RevisionCard",
      "description": "Active recall revision cards with spaced repetition metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique card identifier" },
        "userId": { "type": "string", "description": "Student owner UID" },
        "subject": { "type": "string", "description": "Subject name" },
        "topic": { "type": "string", "description": "Specific concept topic" },
        "question": { "type": "string", "description": "Front prompt question" },
        "answer": { "type": "string", "description": "Back answer text" },
        "explanation": { "type": "string", "description": "Conceptual explanation" },
        "example": { "type": "string", "description": "Concrete illustrative example" },
        "keyTakeaway": { "type": "string", "description": "Summary takeaway" },
        "source": { "type": "object", "description": "Originating source metadata (plan, tutor, quiz, document)" },
        "difficultyLevel": { "type": "string", "description": "Beginner | Intermediate | Advanced" },
        "status": { "type": "string", "description": "Needs Review | Developing | Strong | Mastered" },
        "repetitionIntervalDays": { "type": "number", "description": "Current spaced repetition interval in days" },
        "easeFactor": { "type": "number", "description": "SM-2 cognitive ease multiplier" },
        "consecutiveCorrect": { "type": "number", "description": "Streak of successful recall attempts" },
        "consecutiveIncorrect": { "type": "number", "description": "Count of consecutive failed recalls" },
        "totalReviews": { "type": "number", "description": "Total recall attempts" },
        "successfulRecalls": { "type": "number", "description": "Successful recall count" },
        "incorrectRecalls": { "type": "number", "description": "Incorrect recall count" },
        "lastReviewedAt": { "type": "number", "description": "Timestamp ms of last review" },
        "nextReviewDate": { "type": "string", "description": "Scheduled review date (YYYY-MM-DD)" },
        "nextReviewTimestamp": { "type": "number", "description": "Scheduled review timestamp ms" },
        "priorityScore": { "type": "number", "description": "Computed queue priority score" },
        "isHidden": { "type": "boolean", "description": "Whether card is hidden from queue" },
        "isMastered": { "type": "boolean", "description": "Whether concept is fully mastered" },
        "createdAt": { "type": "number", "description": "Creation timestamp ms" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp ms" }
      },
      "required": ["id", "userId", "subject", "topic", "question", "answer", "status", "nextReviewDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents keyed by Auth UID"
    },
    "/studyPlans/{planId}": {
      "schema": "StudyPlan",
      "description": "User study plan documents"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Revision notes documents"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Interactive quiz documents"
    },
    "/quizResults/{resultId}": {
      "schema": "QuizResult",
      "description": "Completed quiz outcome records"
    },
    "/chatSessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "AI Tutor dialogue session documents"
    },
    "/studySessions/{sessionId}": {
      "schema": "StudySession",
      "description": "Focus timer and study session logs"
    },
    "/revisionCards/{cardId}": {
      "schema": "RevisionCard",
      "description": "Spaced repetition revision card documents"
    }
  }
}
